# 依赖与构建产物
node_modules/
dist/
dist-portable/
src-tauri/target/
src-tauri/gen/

# 便携运行时数据（绝不入库：含 SQLite 数据库与运行日志）
data/

# 测试脚本输出的截图。
#
# ★ 绝不入库。截的是真实桌面，会带上其它窗口的标题、用户的目录路径，
#   甚至是浏览器里登录着的后台页面 —— 这类东西一旦推上去，**后续删文件也没用**，
#   历史里的 blob 依然能被翻出来（本仓库为此重写过一次历史）。
#   这几张图都能跑 scripts\ 里的脚本重新生成，不需要进版本库。
artifacts/

# 沙箱内重定向的包管理缓存（构建脚本使用）
.npm-cache/
.pnpm-store/
.pnpm-home/

# 本地环境
*.local
.env
.env.*

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log

# Python（宣传片脚本）
__pycache__/
*.pyc
